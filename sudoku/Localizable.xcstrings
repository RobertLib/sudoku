    "First Victory" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "První vítězství"
          }
        }
      }
    },
    "Five difficulty levels. Puzzles are made right on your device, no internet needed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pět úrovní obtížnosti. Sudoku se vytvářejí přímo ve vašem zařízení, bez internetu."
          }
        }
      }
    },

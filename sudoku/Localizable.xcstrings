    },
    "Wrong numbers turn red right away and count as mistakes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybná čísla se hned zbarví červeně a počítají se jako chyby."

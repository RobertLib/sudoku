      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez chybičky"
          }
        }
      }
    },
    "Focus on the number %lld." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaměřte se na číslo %lld."
          }
        }
      }
    },
    "Follow the chain of two-candidate cells from %@ to %@: whatever the first cell turns out to be, one of the ends must be %lld. Remove %lld from cells that see both ends." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte řetězec polí se dvěma kandidáty od %@ do %@: ať bude v prvním poli kterýkoli z jeho kandidátů, na jednom z konců musí být %lld. Odstraňte %lld z polí, která vidí oba konce."
          }
        }
      }
    },
    "Following the alternating links of %lld shows that %@ or %@ must be %lld. Remove it from cells that see both ends." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze střídajících se vazeb čísla %lld plyne, že v poli %@ nebo %@ musí být %lld. Odstraňte ho z polí, která vidí oba konce."
          }
        }
      }
    },
    "Four cells of a row, column or box that together contain only four numbers." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyři pole v řádku, sloupci nebo čtverci, která dohromady obsahují jen čtyři čísla."
          }
        }
      }
    },
    "Four numbers that fit only in the same four cells of a row, column or box." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyři čísla, která se v řádku, sloupci nebo čtverci vejdou jen do stejných čtyř polí."
          }
        }
      }
    },

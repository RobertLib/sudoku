    "%lld from %@" : {
      "comment" : "Elimination item in a hint: <digit> from <cell coordinate>.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld z %@"
          }
        }
      }
    },
    "%lld has only two possible cells in a row and in a column, and the two pairs meet in one box. So %@ or %@ must be %lld – remove it from cells that see both." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číslo %lld má v jednom řádku i v jednom sloupci jen dvě možná pole a obě dvojice se setkávají v jednom čtverci. Proto v poli %@ nebo %@ musí být %lld – odstraňte ho z polí, která vidí obě."
          }
        }
      }
    },

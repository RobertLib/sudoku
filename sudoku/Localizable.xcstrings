    "Well Done!" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrá práce!"
          }
        }
      }
    },
    "Well-Rounded" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všestrannost"
          }
        }
      }
    },
    "When every unsolved cell but one has exactly two candidates, the extra candidate of that cell is the answer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když mají všechna nevyřešená pole kromě jednoho přesně dva kandidáty, patří do tohoto jednoho pole jeho přebývající kandidát."
          }
        }
      }
    },
    "Win 10 games in a row." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhrajte 10 her po sobě."
          }
        }
      }
    },
    "Win 5 games in a row." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhrajte 5 her po sobě."

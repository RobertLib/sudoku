    "Sudoku" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudoku"
          }
        }
      }
    },
    "Sudoku board" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mřížka sudoku"
          }
        }
      }
    },
    "Sudoku is shown in Czech when your device uses Czech, and in English otherwise. If your device has more than one preferred language, you can pick one for this app in the Settings app." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudoku se zobrazuje česky, pokud vaše zařízení používá češtinu, jinak anglicky. Pokud máte v zařízení nastaveno více preferovaných jazyků, můžete jazyk této aplikace změnit v aplikaci Nastavení."
          }
        }
      }
    },
    "Swift Solver" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlík"
          }
        }
      }
    },
    "Swordfish" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mečoun"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podle systému"
          }
        }
      }
    },
    "Tap a cell and type the numbers from your puzzle, or paste one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na pole a zapište čísla ze svého sudoku, nebo celé zadání vložte ze schránky."
          }
        }
      }
    },
    "Tap a cell, then tap a number. Tap the same number again to remove it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na pole a pak na číslo. Dalším klepnutím na stejné číslo ho odstraníte."
          }
        }
      }
    },
    "Teal" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyrkysová"
          }
        }
      }
    },
    "Techniques" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Techniky"
          }
        }
      }
    },
    "The board is full, but something's not right." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mřížka je plná, ale něco nesedí."
          }
        }
      }
    },
    "The game will end and count as not solved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra skončí a započítá se jako nevyřešená."
          }
        }
      }
    },
    "The game will end and count as not solved. If you play this daily challenge again, it will count as solved with hints." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra skončí a započítá se jako nevyřešená. Když tuto denní výzvu zahrajete znovu, započítá se jako vyřešená s nápovědou."
          }
        }
      }
    },
    "The Goal" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cíl hry"
          }
        }
      }
    },
    "The last empty cell of a row, column or box gets the only missing number." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do posledního prázdného pole v řádku, sloupci nebo čtverci patří jediné chybějící číslo."
          }
        }
      }
    },
    "The notes in %lld highlighted cells are missing the correct number." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The notes in the highlighted cell are missing the correct number."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The notes in %lld highlighted cells are missing the correct number."
                }
              }
            }
          }
        },
        "cs" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "V poznámkách zvýrazněného pole chybí správné číslo."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "V poznámkách %lld zvýrazněných polí chybí správné číslo."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "V poznámkách %lld zvýrazněného pole chybí správné číslo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "V poznámkách %lld zvýrazněných polí chybí správné číslo."
                }
              }
            }
          }
        }
      }
    },
    "The pivot %@ holds %@. Whatever it turns out to be, %lld ends up in the pivot or in one of the wings %@ and %@. Cells that see all three can't be %lld." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Středové pole %@ má kandidáty %@. Ať v něm bude kterýkoli z nich, číslo %lld skončí ve středovém poli nebo v jednom z křídel %@ a %@. Pole, která vidí všechna tři, nemohou obsahovat %lld."
          }
        }
      }
    },
    "The pivot %@ is either %lld or %lld. Either way, one of the wings %@ or %@ becomes %lld, so %lld can be removed from cells that see both wings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve středovém poli %@ je buď %lld, nebo %lld. V obou případech bude v jednom z křídel %@ a %@ číslo %lld, takže %lld lze odstranit z polí, která vidí obě křídla."
          }
        }
      }
    },
    "The strong links of %lld split its cells into two colors, and one color must be right. Cells that see both colors can't be %lld." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silné vazby čísla %lld rozdělí pole s tímto kandidátem do dvou barev a jedna z barev musí být správná. Pole, která vidí obě barvy, nemohou obsahovat %lld."
          }
        }
      }
    },
    "The strong links of %lld split its cells into two colors. Two cells of the same color see each other, so that color is wrong and %lld can be removed from all its cells." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silné vazby čísla %lld rozdělí pole s tímto kandidátem do dvou barev. Dvě pole stejné barvy se navzájem vidí, takže tato barva je chybná a %lld lze odstranit ze všech jejích polí."
          }
        }
      }
    },
    "The X-Wing idea extended to four rows and four columns." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Princip X-Wingu rozšířený na čtyři řádky a čtyři sloupce."
          }
        }
      }
    },
    "The X-Wing idea extended to three rows and three columns." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Princip X-Wingu rozšířený na tři řádky a tři sloupce."
          }
        }
      }
    },
    "This puzzle needs a technique beyond the hint engine. You can reveal a cell instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto sudoku vyžaduje techniku, kterou nápověda nezná. Můžete místo toho odhalit pole."
          }
        }
      }
    },
    "Three cells of a row, column or box that together contain only three numbers." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři pole v řádku, sloupci nebo čtverci, která dohromady obsahují jen tři čísla."
          }
        }
      }
    },
    "Three numbers that fit only in the same three cells of a row, column or box." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři čísla, která se v řádku, sloupci nebo čtverci vejdou jen do stejných tří polí."
          }
        }
      }
    },
    "Time" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes"
          }
        }
      }
    },
    "Today's puzzle" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní sudoku"
          }
        }
      }
    },
    "Toggle notes" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepnout poznámky"
          }
        }
      }
    },
    "Toggles the note in the selected cell" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepne poznámku ve vybraném poli"
          }
        }
      }
    },
    "Turn on Notes to jot down candidates. Auto Notes in the menu fills them in for you." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Poznámky a zapisujte si kandidáty. Automatické poznámky v menu je vyplní za vás."
          }
        }
      }
    },
    "Two cells of a row, column or box with the same two candidates. Those numbers can be removed from its other cells." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě pole se stejnými dvěma kandidáty v jednom řádku, sloupci nebo čtverci. Tato čísla lze ze zbytku řádku, sloupce či čtverce odstranit."
          }
        }
      }
    },
    "Two identical two-candidate cells connected by a strong link on one of their numbers: a row, column or box where it has only two places." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě pole se stejnou dvojicí kandidátů, propojená silnou vazbou jednoho z těchto čísel: řádkem, sloupcem nebo čtvercem, kde má jen dvě místa."
          }
        }
      }
    },
    "Two numbers that fit only in the same two cells of a row, column or box. Other candidates can be removed from those cells." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě čísla, která se v řádku, sloupci nebo čtverci vejdou jen do stejných dvou polí. Ostatní kandidáty z těchto polí lze odstranit."
          }
        }
      }
    },
    "Two parallel lines where a number has just two places, with one end of each lined up. One of the other ends must hold the number." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě rovnoběžné řady, v nichž má číslo jen dvě místa a jeden konec každé dvojice leží v jedné linii. Číslo pak musí být na jednom ze zbývajících dvou konců."
          }
        }
      }
    },
    "Undo" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odvolat"
          }
        }
      }
    },
    "Undo and erase" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vracení a mazání"
          }
        }
      }
    },
    "Undo as many steps as you like. Erase clears a number or the notes of a cell." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahy můžete vracet bez omezení. Tlačítko Smazat odstraní z pole číslo nebo poznámky."
          }
        }
      }
    },
    "Undo the last mistake and keep going" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrátit chybný tah a hrát dál"
          }
        }
      }
    },
    "Unique Rectangle" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obdélník jednoznačnosti"
          }
        }
      }
    },
    "Unless %@ or %@ is %lld, the four highlighted cells could swap their numbers and the puzzle would have two solutions. So one of them is %lld, and cells that see both can't be %lld." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud v poli %@ ani v %@ nebude %lld, mohla by si čtyři zvýrazněná pole prohodit čísla a sudoku by mělo dvě řešení. Jedno z těchto dvou polí tedy musí obsahovat %lld a pole, která vidí obě, nemohou obsahovat %lld."
          }
        }
      }
    },
    "Unlock number" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemknout číslo"
          }
        }
      }
    },
    "Unlocked" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemčeno"
          }
        }
      }
    },
    "Unlocks the number" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemkne číslo"
          }
        }
      }
    },
    "Unstoppable" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezastavitelná série"
          }
        }

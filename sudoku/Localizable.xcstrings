    },
    "Fill the grid so that every row, every column and every 3×3 box contains each number from 1 to 9 exactly once." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplňte mřížku tak, aby každý řádek, každý sloupec a každý čtverec 3×3 obsahoval všechna čísla od 1 do 9 právě jednou."
          }
        }
      }
    },
    "Finish a puzzle and your statistics will appear here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokončete sudoku a objeví se tu vaše statistiky."

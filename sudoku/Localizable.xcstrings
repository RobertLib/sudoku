{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %@ can only be %lld or %lld. Thanks to the strong link on %lld, one of them must be %lld – remove %lld from cells that see both." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V polích %@ a %@ může být jen %lld nebo %lld. Díky silné vazbě čísla %lld musí v jednom z nich být %lld – odstraňte %lld z polí, která vidí obě."
          }
        }
      }
    },
    "%@ can only hold %lld – every other number already appears in its row, column or box." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do pole %@ patří jen číslo %lld – všechna ostatní čísla už jsou v jeho řádku, sloupci nebo čtverci."
          }
        }
      }
    },
    "%@ can only hold %lld – it's the only candidate left in this cell." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do pole %@ patří jen číslo %lld – je to jediný kandidát, který v něm zbyl."
          }
        }
      }
    },

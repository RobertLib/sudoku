    },
    "Win rate" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úspěšnost"
          }
        }
      }
    },
    "With instant checking, wrong numbers turn red. Three mistakes end the game unless you turn the limit off – but you get one second chance." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při okamžité kontrole se chybná čísla zbarví červeně. Tři chyby ukončí hru, pokud limit nevypnete – jednu druhou šanci ale dostanete."
          }
        }
      }
    },
    "Works completely offline. No ads, no accounts, no tracking – your games and statistics stay on this device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje zcela offline. Žádné reklamy, účty ani sledování – vaše hry a statistiky zůstávají v tomto zařízení."
          }
        }
      }
    },
    "Wrong number." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybné číslo."
          }
        }
      }
    },
    "Wrong number. Mistake %lld of %lld." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
